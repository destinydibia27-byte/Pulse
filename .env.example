# --- AI parsing (Groq) ---
# Optional. Without this, /api/parse runs a tiny keyword-based mock parser
# so the demo loop still works offline. Set this for real intent parsing.
GROQ_API_KEY=
# Optional, defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=

# --- Chain (Arbitrum Sepolia) ---
# Optional. Without all three set, /api/execute runs in MOCK MODE and
# does not send a real transaction — it just exercises the loop's shape.
# Used server-side for (1) the balance read in "Check rule" and (2) executing.
# Never exposed to the browser (error messages are sanitized so keys in the URL don't leak).
ARBITRUM_SEPOLIA_RPC_URL=
PULSE_CONTRACT_ADDRESS=
EXECUTOR_PRIVATE_KEY=

# --- Browser-side (must be NEXT_PUBLIC_ to reach the wallet flow) ---
# Same contract address as PULSE_CONTRACT_ADDRESS above.
NEXT_PUBLIC_PULSE_CONTRACT_ADDRESS=
# Optional. Defaults to Circle's documented Arbitrum Sepolia USDC
# (0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d). Validated at startup; a malformed
# value fails loudly. Leave empty unless you're using a different token.
NEXT_PUBLIC_USDC_ADDRESS=

# --- Demo recipient ("savings") ---
# Optional. Server-side. Defaults to a PUBLIC Anvil dev address (anyone can spend
# from it) which is only OK for valueless testnet demos. Set your own wallet.
DEMO_SAVINGS_ADDRESS=
# Optional, falls back to the chain's default public RPC.
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# --- Worker / shared DB ---
# The web app and the worker MUST point at the same file. Default: <repo>/data/automations.json.
PULSE_DB_PATH=
# Worker poll interval in ms (default 60000).
POLL_INTERVAL_MS=
# Set to false on any deployment other people can reach. Disables "Run now (demo)".
ENABLE_DEMO_FIRE=true
